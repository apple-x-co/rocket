{
  "version": "1.2",
  "slack": {
    "channel": "channel-name",
    "username": "project-name",
    "chatPostMessageUrl": "https://slack.com/api/chat.postMessage",
    "appOauthToken": "SLACK_APP_OAUTH_TOKEN",
    "icon": ":tada:"
  },
  "user": "centos-user",
  "source": {
    "directory": "/home/sample/source/"
  },
  "url": "https://example.com/",
  "destinations": [
    {
      "from": "/home/sample/source/htdocs/",
      "to": "/var/www/vhosts/example.com/htdocs/",
      "excludes": [
        ".gitkeep",
        ".gitignore",
        ".editorconfig",
        "healthcheck.txt"
      ]
    },
    {
      "from": "/home/sample/source/data/",
      "to": "/var/www/vhosts/example.com/data/"
    }
  ],
  "rsync" : {
    "path": "/usr/bin/rsync",
    "option": "--recursive --links --checksum --verbose --human-readable --delete"
  },
  "git": {
    "path": "/usr/bin/git"
  }
}
